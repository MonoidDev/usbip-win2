; Copyright (c) 2022-2025 Vadym Hrynchyshyn <vadimgrn@gmail.com>
;
; usbip2_filter.inf
; Upper-level device-specific filter driver.
; @see Using an Extension INF File

[Version]
Signature = "$WINDOWS NT$"
Class = Extension
ClassGuid = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider = %Manufacturer%
ExtensionId = {c1e0d1fe-d564-596e-4526-71da1249702a}
CatalogFile = usbip2_filter.cat
PnpLockDown = 1

[DestinationDirs]
DefaultDestDir = 13 ; DriverStore

[SourceDisksNames]
1 = "USBip Upper Filter Installation Disk"

[SourceDisksFiles]
usbip2_filter.sys = 1

[Manufacturer]
; Windows 10, version 1809 (Windows Server 2019) and later.
; The Models section with the highest build number that is not higher than the OS build number is used.
%Manufacturer% = Generic, NT$ARCH$.10.0...17763, NT$ARCH$.10.0...18362

; Windows 10, version 1809 (OS build 17763), it is Windows Server 2019
[Generic.NT$ARCH$.10.0...17763]
; HWID of "USB Root Hub (USB 3.0)" located on "USBip 3.X Emulated Host Controller"
; See C:\Windows\INF\usbhub3.inf
%DisplayName% = Generic_Inst_1809, USB\ROOT_HUB30

; Windows 10, version 1903 (OS build 18362) and later
[Generic.NT$ARCH$.10.0...18362]
%DisplayName% = Generic_Inst, USB\ROOT_HUB30

[Generic_Inst.NT$ARCH$]
CopyFiles = @usbip2_filter.sys

[Generic_Inst.NT$ARCH$.Filters]  
; this directive is supported in Windows 10 version 1903 and later
AddFilter = usbip2_filter,,usbip2_filter_Filter_Inst
  
[usbip2_filter_Filter_Inst]
; HKLM\SYSTEM\CurrentControlSet\Enum\USB\ROOT_HUB30\<DEVICE_ID>\Filters\*Upper
FilterPosition = Upper

[Generic_Inst.NT$ARCH$.Services]
AddService = usbip2_filter,,usbip2_filter_Service_Inst

; Windows 10, version 1809 does not support AddFilter directive, the filter driver is registered 
; in the legacy way. It is not unregistered by "pnputil /delete-driver <oem#.inf> /uninstall",
; setup.iss runs "devnode.exe filter remove upper USB\ROOT_HUB30 usbip2_filter" for that.
; @see Device Filter Driver Ordering, Legacy-equivalent filter registration
[Generic_Inst_1809.NT$ARCH$]
CopyFiles = @usbip2_filter.sys

[Generic_Inst_1809.NT$ARCH$.HW]
AddReg = usbip2_filter_AddReg

[usbip2_filter_AddReg]
; HKLM\SYSTEM\CurrentControlSet\Enum\USB\ROOT_HUB30\<DEVICE_ID>\UpperFilters
; 0x00010008 = FLG_ADDREG_TYPE_MULTI_SZ | FLG_ADDREG_APPEND, append this service to the list if it is not there
HKR,,UpperFilters,0x00010008,usbip2_filter

[Generic_Inst_1809.NT$ARCH$.Services]
AddService = usbip2_filter,,usbip2_filter_Service_Inst

[usbip2_filter_Service_Inst]
DisplayName    = %DisplayName%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 2               ; SERVICE_ERROR_SEVERE
ServiceBinary  = %13%\usbip2_filter.sys
AddReg         = usbip2_filter_Service_AddReg

[usbip2_filter_Service_AddReg]
; Inflight Trace Recorder (IFR) parameter "VerboseOn".
; The default setting of zero causes the IFR to log errors, warnings, and informational events
HKR,Parameters,VerboseOn,0x00010001,1 ; show TRACE_LEVEL_VERBOSE

[Strings]
Manufacturer="USBIP-WIN2"
DisplayName="USBip Upper Filter for USBHUB3" ; for device and service
